# ---- RiboHub Docker Configuration ----
# Copy this file to .env and fill in your values.

# IP or hostname where Apache is reachable (UCSC/GWIPS needs to reach this)
SERVER_IP=localhost

# Path to the directory containing sorted bigWig files on the host
BIGWIG_DIR=/home/guest/dual_docker/Data

# Path to the RiboSeqOrg metadata CSV on the host
METADATA_CSV=/home/guest/dual_docker/Data/Metadata/RiboSeqOrg_Metadata.csv

# Ports (defaults: Apache=80, Galaxy=8080)
APACHE_PORT=80
GALAXY_PORT=8080