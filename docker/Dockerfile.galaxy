FROM quay.io/bgruening/galaxy:latest

# ── Install RiboHub as a pip package ──
COPY ribohub.py pyproject.toml /tmp/ribohub-install/
RUN /tool_deps/_conda/bin/pip install /tmp/ribohub-install/ && \
    rm -rf /tmp/ribohub-install/

# ── Copy Galaxy tool wrapper ──
COPY ribohub.xml /etc/galaxy/ribohub.xml

# ── Register tool on startup ──
# Inject registration into /usr/bin/startup (runs before Galaxy boots).
# Idempotent: only adds the line if not already present.
COPY docker/register_tool.sh /usr/local/bin/register_ribohub.sh
RUN chmod +x /usr/local/bin/register_ribohub.sh && \
    sed -i '2i /usr/local/bin/register_ribohub.sh' /usr/bin/startup
RUN sed -i '2i chown -R galaxy:galaxy /export/galaxy/hub_output 2>/dev/null' /usr/bin/startup
RUN sed -i '2i sed -i "s|/home/galaxy/venv/bin/activate|/galaxy_venv/bin/activate|g" /etc/galaxy/job_conf.xml 2>/dev/null' /usr/bin/startup
