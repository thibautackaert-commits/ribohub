# ---- RiboHub Docker Configuration ----
# Copy this file to .env and fill in your values.

# IP or hostname where Apache is reachable (GWIPS needs to reach this)
SERVER_IP= your.server.ip

# Path to the directory containing sorted data files on the host
DATA_DIR= /path/to/data

# Path to the RiboSeqOrg metadata CSV on the host
METADATA_CSV= /path/to/RiboSeqOrg_Metadata.csv

# Ports (defaults: Apache=80, Galaxy=8080)
APACHE_PORT=80
GALAXY_PORT=8080
